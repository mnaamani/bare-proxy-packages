{
  "name": "bare-proxy-packages",
  "version": "0.0.0",
  "description": "Proxy agents for Bare - socks5, http forward and http CONNECT, and the plumbing they share",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "npm test --workspaces",
    "examples": "node scripts/run-examples.mjs",
    "types": "tsc --noEmit && node scripts/check-typings.mjs",
    "lint": "prettier . --check && node scripts/check-ascii.mjs && lunte && npm run types",
    "format": "prettier . --write"
  },
  "devDependencies": {
    "bare-buffer": "^3.7.1",
    "bare-fetch": "^3.4.0",
    "bare-http1": "^4.6.2",
    "bare-runtime": "^1.29.5",
    "bare-tcp": "^2.6.1",
    "bare-url": "^2.5.4",
    "bare-ws": "^3.2.0",
    "brittle": "^3.19.0",
    "lunte": "^1.2.0",
    "prettier": "^3.6.2",
    "prettier-config-holepunch": "^2.0.0",
    "typescript": "^5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mnaamani/bare-proxy-packages.git"
  },
  "author": "Mokhtar Naamani",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/mnaamani/bare-proxy-packages/issues"
  }
}
