{
  "name": "barex-proxy-agent",
  "version": "0.1.0",
  "description": "Tunnel http and websocket traffic through a proxy under Bare: the socket, agents and handshake plumbing every proxy protocol shares",
  "main": "index.mjs",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.mjs"
    },
    "./package": "./package.json"
  },
  "files": [
    "index.mjs",
    "index.d.ts",
    "lib",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "scripts": {
    "test": "brittle-bare test/index.mjs"
  },
  "dependencies": {
    "bare-http1": "^4.6.2",
    "bare-stream": "^2.13.1",
    "bare-tcp": "^2.5.0",
    "bare-tls": "^3.1.7"
  },
  "devDependencies": {
    "bare-buffer": "^3.7.1",
    "bare-fetch": "^3.2.0",
    "bare-http1": "^4.6.0",
    "bare-tcp": "^2.5.0",
    "bare-url": "^2.5.4",
