{
  "name": "barex-proxy-from-env",
  "version": "0.1.0",
  "description": "Read the proxy the environment asks for - http_proxy, https_proxy, ALL_PROXY and no_proxy - under Bare",
  "main": "index.mjs",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.mjs"
    },
    "./package": "./package.json"
  },
  "files": [
    "index.mjs",
    "index.d.ts",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "scripts": {
    "test": "brittle-bare test/index.mjs"
  },
  "dependencies": {
    "bare-process": "^4.5.0"
  },
  "devDependencies": {
    "bare-url": "^2.5.4",
    "brittle": "^3.19.0"
  },
  "peerDependencies": {
    "bare-url": "*"
  },
  "peerDependenciesMeta": {
    "bare-url": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mnaamani/bare-proxy-packages.git",
    "directory": "packages/barex-proxy-from-env"
  },
  "author": "Mokhtar Naamani",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/mnaamani/bare-proxy-packages/issues"
  },
  "keywords": [
    "bare",
    "proxy",
    "environment",
    "http_proxy",
    "no_proxy"
  ]
}
